{
  "realm": "apexpredict",
  "enabled": true,
  "displayName": "ApexPredict",
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "internationalizationEnabled": true,
  "supportedLocales": ["es", "en"],
  "defaultLocale": "es",
  "passwordPolicy": "length(6)",
  "resetPasswordAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "smtpServer": {
    "host": "smtp.gmail.com",
    "port": "587",
    "from": "noreply@apexpredict.com",
    "fromDisplayName": "ApexPredict F1",
    "auth": "true",
    "ssl": "false",
    "starttls": "true",
    "user": "apexpredict.notifications@gmail.com",
    "password": ""
  },
  "loginTheme": "apexpredict",
  "defaultRole": { "name": "default-roles-apexpredict" },
  "roles": {
    "realm": [
      { "name": "player", "description": "Participante del prode" },
      { "name": "admin", "description": "Administrador de ApexPredict" },
      {
        "name": "default-roles-apexpredict",
        "description": "Roles iniciales de las cuentas de ApexPredict",
        "composite": true,
        "composites": { "realm": ["player"] }
      }
    ]
  },
  "clients": [
    {
      "clientId": "apexpredict-web",
      "name": "ApexPredict Angular",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://dacs-nine.vercel.app/*",
        "https://dacs2026.local/apexpredict/*",
        "https://dacs2026.local/DACS/*",
        "http://localhost:4200/*",
        "http://localhost:4200/DACS/*",
        "https://localhost:4200/*"
      ],
      "webOrigins": [
        "https://dacs-nine.vercel.app",
        "https://dacs2026.local",
        "http://localhost:4200",
        "https://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://dacs-nine.vercel.app/*##https://dacs2026.local/apexpredict/*##https://dacs2026.local/DACS/*##http://localhost:4200/*##http://localhost:4200/DACS/*##https://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "apexpredict-bff-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "apexpredict-bff",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "apexpredict-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "apexpredict-backend",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
